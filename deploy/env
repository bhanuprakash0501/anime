# Settings for the Sketch Aquarium service (read by systemd / start.sh)
PORT=8000
# 127.0.0.1 = only nginx on this box can reach the app; 0.0.0.0 = expose it directly
BIND=127.0.0.1
TTL=120
# leave empty: the app derives the public address from the proxy headers / the browser
PUBLIC_URL=
ADMIN_KEY=
# auto-update: only deploy commits whose GitHub Actions 'test' job passed (0 = deploy any push)
REQUIRE_CI=1
